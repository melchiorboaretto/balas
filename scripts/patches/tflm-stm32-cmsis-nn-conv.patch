+enum {
+  kBalasConvDiagCalls = 0,
+  kBalasConvDiagCmsisSuccess = 1,
+  kBalasConvDiagFallbackInt8 = 2,
+  kBalasConvDiagError = 3,
+  kBalasConvDiagCalls1x1 = 4,
+  kBalasConvDiagSuccess1x1 = 5,
+  kBalasConvDiagFallback1x1 = 6,
+  kBalasConvDiagCalls3x3 = 7,
+  kBalasConvDiagSuccess3x3 = 8,
+  kBalasConvDiagFallback3x3 = 9,
+  kBalasConvDiagScratchMissing = 10,
+  kBalasConvDiagLastStatus = 11,
+  kBalasConvDiagPersistentScratch = 12,
+  kBalasConvDiagScratchTooSmall = 13,
+  kBalasConvDiagArenaScratch = 14,
+  kBalasConvDiagBufferIdxValid = 15,
+  kBalasConvDiagLastBufferIdx = 16,
+  kBalasConvDiagLastRequiredScratch = 17,
+  kBalasConvDiagMaxRequiredScratch = 18,
+  kBalasConvDiagCount = 19,
+};
+
+static volatile uint32_t g_balas_conv_diag[kBalasConvDiagCount];
+
+extern "C" void balas_tflm_conv_diag_reset(void) {
+  for (int i = 0; i < kBalasConvDiagCount; ++i) {
+    g_balas_conv_diag[i] = 0;
+  }
+}
+
+extern "C" void balas_tflm_conv_diag_read(uint32_t* out, int out_count) {
+  if (out == nullptr || out_count <= 0) {
+    return;
+  }
+  for (int i = 0; i < out_count; ++i) {
+    out[i] = (i < kBalasConvDiagCount) ? g_balas_conv_diag[i] : 0;
+  }
+}
+
+static bool BalasConvIs1x1(const cmsis_nn_dims& filter_dims) {
+  return filter_dims.h == 1 && filter_dims.w == 1;
+}
+
+static bool BalasConvIs3x3(const cmsis_nn_dims& filter_dims) {
+  return filter_dims.h == 3 && filter_dims.w == 3;
+}
+
+static void BalasConvDiagRecordCall(const cmsis_nn_dims& filter_dims,
+                                    const cmsis_nn_context& ctx) {
+  ++g_balas_conv_diag[kBalasConvDiagCalls];
+  if (BalasConvIs1x1(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagCalls1x1];
+  } else if (BalasConvIs3x3(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagCalls3x3];
+  }
+  if (ctx.buf == nullptr) {
+    ++g_balas_conv_diag[kBalasConvDiagScratchMissing];
+  }
+}
+
+static void BalasConvDiagRecordSuccess(const cmsis_nn_dims& filter_dims) {
+  ++g_balas_conv_diag[kBalasConvDiagCmsisSuccess];
+  if (BalasConvIs1x1(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagSuccess1x1];
+  } else if (BalasConvIs3x3(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagSuccess3x3];
+  }
+}
+
+static void BalasConvDiagRecordFallback(const cmsis_nn_dims& filter_dims) {
+  ++g_balas_conv_diag[kBalasConvDiagFallbackInt8];
+  if (BalasConvIs1x1(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagFallback1x1];
+  } else if (BalasConvIs3x3(filter_dims)) {
+    ++g_balas_conv_diag[kBalasConvDiagFallback3x3];
+  }
+}
